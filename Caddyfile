{
	# No admin API on :2019 (host network, may clash with another Caddy); config changes = container restart.
	admin off
	# Xray owns :443 and passes browsers here; nothing listens on :80 since certificates come via DNS.
	auto_https disable_redirects
	default_bind 127.0.0.1
	# No HTTP/3: it would advertise Alt-Svc h3=":8443", a port that is not reachable from outside.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN}:8443 {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode zstd gzip
	header {
		# No "Server: Caddy": the site should not tell what serves it.
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Next.js inlines its bootstrap scripts; the API is proxied by the site itself, avatars come from Telegram.
	# A direct visit or a probe may not frame the site and does not see who may.
	@top not header Sec-Fetch-Dest iframe
	header @top {
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	# Only the RemnaWeb Mini App frames the site (Игра → Играть): FRAME_ANCESTORS lists its origin and Telegram's.
	@framed header Sec-Fetch-Dest iframe
	header @framed Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors {$FRAME_ANCESTORS:'none'}; base-uri 'self'; form-action 'self'; object-src 'none'"
	reverse_proxy 127.0.0.1:{$PORT:8080}
}
