# --- Site ---
# The game and the country are RemnaWeb's: the admin picks the game (Админка → Игра → Игровые сайты), the country is
# that of the panel host with this DOMAIN as its SNI. The site asks RemnaWeb for both by DOMAIN (see below).

# RemnaWeb URL (https), required: the game, the country, the rules and texts come from it; also used for Telegram sign-in and progress sync.
# Only the site's server talks to it: pages call this site's /api/sni/*, which is passed on to RemnaWeb.
# Add this site's origin to SNI_ORIGINS in RemnaWeb.
REMNAWEB_URL=

# Optional footer text ("© <year> <text>"); empty = no footer, so nothing ties the node sites together.
SITE_FOOTER=

# Who may open the site in a frame: the RemnaWeb origin and Telegram's web clients, which frame RemnaWeb.
# Enables "Играть" right in the Mini App; empty = nobody (the site opens only in a browser).
# FRAME_ANCESTORS=https://app.example.com https://web.telegram.org https://*.telegram.org
FRAME_ANCESTORS=

# Local port of the site behind Caddy (127.0.0.1 only).
PORT=8080

# --- Caddy (TLS for the self-SNI domain) ---
# The node's domain: a DNS-only (grey cloud) A record in Cloudflare pointing at the node.
DOMAIN=de.example.com
# Cloudflare API token with Zone:Read and DNS:Edit, limited to this one zone (Zone Resources → Specific zone);
# certificates are issued via DNS-01. Caddy runs with host networking, so keep the token's reach small.
CF_API_TOKEN=
