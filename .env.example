# ISO 3166-1 alpha-2 code of the node's country: de, nl, fi, us, ...
# Read at request time, so one image serves every node.
NODE_COUNTRY=de

# Host port the site listens on (bind it to your TLS proxy / Xray fallback).
PORT=8080

# RemnaWeb URL for Telegram sign-in and progress sync; leave empty to hide sign-in.
# Add this site's origin to SNI_ORIGINS in RemnaWeb.
REMNAWEB_URL=
